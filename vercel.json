{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://artix-hub.onrender.com/api/$1"
    },
    {
      "src": "/auth/(.*)",
      "dest": "https://artix-hub.onrender.com/auth/$1"
    },
    { "src": "/me", "dest": "https://artix-hub.onrender.com/me" },
    { "src": "/health", "dest": "https://artix-hub.onrender.com/health" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
